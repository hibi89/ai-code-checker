GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Paid Standard-tier list rates for Gemini 3.1 Flash-Lite as of 2026-10-26.
# If GEMINI_MODEL changes, set both rates to that model's current paid-tier prices.
GEMINI_INPUT_USD_PER_MILLION=0.25
GEMINI_OUTPUT_USD_PER_MILLION=1.50

# One structured AI request; the estimated maximum is checked before sending.
MAX_OUTPUT_TOKENS=4096
MAX_ESTIMATED_COST_USD=0.05
